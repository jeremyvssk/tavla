# ./start.sh copies this file to .env and fills in APP_ENCRYPTION_KEY, the one variable without
# a default. docker-compose.yml carries a working development default for every other one.
# Never commit .env.

# Postgres
POSTGRES_DB=iloveshopping
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
# Backend reads this; host is the compose service name
DATABASE_URL=jdbc:postgresql://postgres:5432/iloveshopping

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Frontend: nginx serves the app over HTTPS on FRONTEND_HTTPS_PORT; plain http on FRONTEND_PORT redirects there
FRONTEND_PORT=5173
FRONTEND_HTTPS_PORT=5443
BACKEND_PORT=8080
# Where the links in order emails point
FRONTEND_URL=https://localhost:5443

# RabbitMQ: the payment-events and order-email queues. Management page on RABBITMQ_UI_PORT.
RABBITMQ_USER=app
RABBITMQ_PASSWORD=changeme
RABBITMQ_URL=amqp://app:changeme@rabbitmq:5672
RABBITMQ_UI_PORT=15672

# AES-256 key for the encrypted order and payment columns: 32 random bytes, base64.
# Leave blank: ./start.sh generates one. Changing or losing it makes the stored orders unreadable.
APP_ENCRYPTION_KEY=

# MailHog (dev only — SMTP on 1025, web UI on 8025)
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# Backend (used once the Spring Boot service is added)
JWT_SECRET=replace-with-a-long-random-string
# Token lifetimes, ISO-8601 durations. Brief requires 15-60m access, 3-7d refresh.
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
SMTP_HOST=mailhog
SMTP_PORT=1025
# From address on outgoing mail (e.g. password reset)
MAIL_FROM=noreply@iloveshopping.local
# Frontend base used to build the reset link in emails
FRONTEND_RESET_URL=https://localhost:5443/reset
# Issuer label shown in authenticator apps for 2FA
TWO_FACTOR_ISSUER=i-love-shopping

# OAuth (fill in when wiring providers)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# reCAPTCHA (fill in when wiring CAPTCHA)
# Registration verifies the token with Google only when RECAPTCHA_ENABLED=true.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Hostname the widget is served from; the siteverify response must match it. Blank skips the check.
RECAPTCHA_HOSTNAME=

# Stripe test mode: dashboard.stripe.com/test/apikeys (a free account, no business details needed).
# The publishable key goes into the browser bundle; the secret key never leaves the backend.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signing secret of the stripe-cli container's forwarding. Leave blank: ./start.sh asks the CLI and fills it in.
STRIPE_WEBHOOK_SECRET=
# How long an unpaid order keeps its items reserved (ISO-8601 duration).
ORDER_PAYMENT_HOLD=PT30M

# Rate limits (per IP on auth and search, per account on login and reset emails). Leave on.
RATE_LIMIT_ENABLED=true

# Refresh cookie Secure flag. The app is served over HTTPS (http redirects), so leave it true:
# the browser then never sends the cookie unencrypted. false only for an http-only setup.
COOKIE_SECURE=true

# Product images: where the backend writes uploads (the product_images_data volume nginx serves).
IMAGES_DIR=/var/app/images
# Drop classpath:db/seed to start with an empty catalog instead of the demo data.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
